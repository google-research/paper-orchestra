# Copy to .env; never commit the real file.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=16384

# Optional HTTP CONNECT proxy. Environment variables take precedence over .env.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890

# Optional; retrieval also uses public Crossref and arXiv APIs.
SEMANTIC_SCHOLAR_API_KEY=

# Optional current prices in USD per million tokens; no prices are assumed.
# ANTHROPIC_PRICE_INPUT_PER_MILLION=
# ANTHROPIC_PRICE_OUTPUT_PER_MILLION=
# Sampling controls are omitted unless explicitly set for a supporting model.
# ANTHROPIC_TEMPERATURE=
