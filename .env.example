# Copy to .env and fill in what you use.

# --- Option A: no API key. Send every LLM call to a logged-in CLI. ---
# claude = Claude Code (`claude` on PATH, logged in); codex = Codex CLI (`codex` on PATH, logged in).
# Leave empty to use the Gemini API (Option B).
PAPER_LLM_BACKEND=claude
# Model for the CLI. claude: opus or sonnet (default opus). codex: leave empty for its default.
PAPER_CLI_MODEL=
# Max CLI sessions at once, and seconds allowed per call.
PAPER_CLI_CONCURRENCY=3
PAPER_CLI_TIMEOUT=900

# --- Option B: Gemini API (upstream behaviour). ---
# Set GEMINI_API_KEY, or both VERTEX_AI_* (Vertex takes precedence).
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=
# Stop the run once the estimated Gemini spend passes this many USD (0 = no limit).
PAPER_BUDGET_USD=0

# Only if you pass an OpenAI model name (gpt-*, o1, o3).
OPENAI_API_KEY=

# Optional: higher Semantic Scholar rate limits for the literature review.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: only for the Streamlit demo's "email me the result" feature.
SMTP_EMAIL=
SMTP_PASSWORD=
